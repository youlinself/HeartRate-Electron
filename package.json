    "@types/react-dom": "^18.0.11",
    "antd-mobile": "^5.36.1",
    "babel-runtime": "^6.26.0",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "click-to-react-component": "1.1.0",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "libpag": "^4.2.84",
    "lint-staged": "^13.2.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "postcss-px-to-viewport": "^1.1.1",
